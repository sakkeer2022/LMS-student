# Backend API origin. The Next /api/v1 rewrite proxies to it so auth cookies stay same-origin.
BACKEND_ORIGIN=http://127.0.0.1:3000
# Where the faculty app runs (the landing page links to its login). No default: set it per environment.
NEXT_PUBLIC_FACULTY_URL=
# Legal line shown in the landing footer, for example "© 2026 <company> · GSTIN <number> · <city>".
NEXT_PUBLIC_COMPANY_LEGAL_LINE=
